{
  "name": "@miri/server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 4007",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply miri --local",
    "db:migrate": "wrangler d1 migrations apply miri --remote",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18",
    "wrangler": "^3.107.0"
  }
}
