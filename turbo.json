{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**"],
      "env": ["ANTHROPIC_API_KEY"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "PORT",
        "DATABASE_URL",
        "GEMINI_API_KEY",
        "KAMIS_API_KEY",
        "KAMIS_API_ID",
        "COUPANG_ACCESS_KEY",
        "COUPANG_SECRET_KEY",
        "JWT_SECRET",
        "KAKAO_CLIENT_ID",
        "KAKAO_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "CLIENT_ORIGIN",
        "PORTONE_STORE_ID",
        "PORTONE_API_SECRET",
        "PORTONE_CHANNEL_KEY",
        "PORTONE_WEBHOOK_SECRET",
        "BILLING_ENCRYPT_KEY",
        "ADMIN_EMAILS",
        "NOTION_API_KEY",
        "GITHUB_APP_ID",
        "GITHUB_WEBHOOK_SECRET",
        "REDIS_HOST",
        "REDIS_PORT",
        "YAHOO_FINANCE_TIMEOUT",
        "PERPLEXITY_API_KEY",
        "NODE_ENV",
        "DATABASE_URL_TEST",
        "ENABLE_DEV_LOGIN",
        "ENABLE_GPS_LOCATION",
        "TRUST_PROXY_HOPS",
        "KAKAO_NATIVE_APP_KEY",
        "KAKAO_ADMIN_KEY",
        "GOOGLE_WEB_CLIENT_ID",
        "GOOGLE_IOS_CLIENT_ID",
        "GOOGLE_ANDROID_CLIENT_ID",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_PUBLIC_BUCKET",
        "R2_PRIVATE_BUCKET",
        "R2_PUBLIC_BASE_URL",
        "EXPO_ACCESS_TOKEN",
        "REMINDER_BOOT_CATCHUP",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "SENTRY_DSN"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
