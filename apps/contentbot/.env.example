# ContentBot Environment Variables

# Naver DataLab API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# WordPress.com REST API
WORDPRESS_SITE_ID=
WORDPRESS_ACCESS_TOKEN=

# Anthropic API (Claude)
