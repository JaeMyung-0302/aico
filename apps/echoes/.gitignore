# Unity 프로젝트 .gitignore
# Unity 에디터가 생성/캐싱하는 대용량·기계생성 파일 제외

# 에디터 생성 폴더
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / 자동생성 솔루션 파일
/.vs/
/.vscode/
/.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store

# Unity 크래시/빌드 산출물
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Asset 메타파일은 커밋해야 하므로 제외하지 않음 (*.meta 는 트래킹 대상)
