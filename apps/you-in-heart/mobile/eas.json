{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "PUPPETEER_SKIP_DOWNLOAD": "1" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "PUPPETEER_SKIP_DOWNLOAD": "1" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "PUPPETEER_SKIP_DOWNLOAD": "1" }
    }
  },
  "submit": { "production": {} }
}
