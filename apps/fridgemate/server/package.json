{
  "name": "@fridgemate/server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env --env-file=.env.local src/main.ts",
    "build": "prisma generate && tsc && cp -r src/generated dist/ && rm -f dist/generated/prisma/*.node dist/generated/prisma/*.wasm",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:pre-push": "node prisma/pre-push.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@portone/server-sdk": "^0.19.0",
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.1",
    "prisma": "^6.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
