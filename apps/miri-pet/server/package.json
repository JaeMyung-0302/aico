{
  "name": "@miri-pet/server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "prisma migrate deploy && node dist/main",
    "lint": "eslint --max-warnings 0",
    "test": "jest",
    "test:int": "jest -c jest.int.config.js --runInBand",
    "check-types": "prisma generate && tsc --noEmit -p tsconfig.check.json",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "admin": "node dist/admin/admin.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@miri-pet/shared": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/platform-socket.io": "^11.1.3",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.3",
    "@prisma/client": "^6.19.2",
    "@sentry/nestjs": "^11.7.0",
    "expo-server-sdk": "^7.2.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "posthog-node": "^5.56.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "prisma": "^6.19.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.2"
  }
}
