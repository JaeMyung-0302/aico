# 공개 값만 (EXPO_PUBLIC_* 는 앱 번들에 포함된다 — 비밀값 금지)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4009/api/v1
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# 네이버 지도(NCP Maps) 공개 Client ID 만 — 지도 SDK 인증용 공개 값. Client Secret 은 앱에 넣지 않는다(장소 검색·역지오코딩은 서버가 한다)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=
# development / preview / production (비우면 production)
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# 개발 빌드에서만 로그인 화면에 '개발용 로그인'(POST /auth/dev)을 보인다. 서버 ENABLE_DEV_LOGIN=true도 필요
EXPO_PUBLIC_ENABLE_DEV_LOGIN=false
# EAS 프로젝트 ID(`eas init` 결과, 공개 값). 비우면 푸시 토큰 등록을 건너뛴다(개발 경고만)
EAS_PROJECT_ID=
