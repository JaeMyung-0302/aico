{
  "name": "aico",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt \"**/*.{ts,tsx,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "oxfmt": "^0.35.0",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=18.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@nestjs/core",
      "puppeteer",
      "bcrypt",
      "better-sqlite3"
    ]
  }
}
