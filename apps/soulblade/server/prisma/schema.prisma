generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id               String    @id @db.Uuid
  displayName      String?   @map("display_name")
  metaGold         Int       @default(0) @map("meta_gold")
  gems             Int       @default(0)
  attendanceStreak Int       @default(0) @map("attendance_streak")
  lastAttendanceDate DateTime? @map("last_attendance_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  characters    Character[]
  equipment     Equipment[]
  skillTree     SkillTree[]
  gameRuns      GameRun[]
  dailyProgress DailyProgress[]
  rpgSaves      RpgSave[]

  @@map("sb_profiles")
}

model Character {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  classType     String   @map("class_type")
  masteryLevel  Int      @default(0) @map("mastery_level")
  masteryExp    Int      @default(0) @map("mastery_exp")
  permanentHp   Int      @default(0) @map("permanent_hp")
  permanentAtk  Int      @default(0) @map("permanent_atk")
  permanentDef  Int      @default(0) @map("permanent_def")
  permanentSpd  Int      @default(0) @map("permanent_spd")
  permanentCrit Int      @default(0) @map("permanent_crit")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  profile       Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  equippedItems Equipment[] @relation("EquippedBy")
  gameRuns      GameRun[]

  @@unique([userId, classType])
  @@map("sb_characters")
}

model Equipment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String
  grade      String
  name       String
  tags       String[] @default([])
  stats      Json     @default("{}")
  equippedBy String?  @map("equipped_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  profile   Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character? @relation("EquippedBy", fields: [equippedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sb_equipment")
}

model SkillTree {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  nodeId     String    @map("node_id")
  level      Int       @default(0)
  unlocked   Boolean   @default(false)
  unlockedAt DateTime? @map("unlocked_at") @db.Timestamptz()

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@map("sb_skill_tree")
}

model GameRun {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  characterId      String   @map("character_id") @db.Uuid
  classType        String   @map("class_type")
  stageId          String   @map("stage_id")
  score            Int      @default(0)
  survivedSeconds  Int      @default(0) @map("survived_seconds")
  monstersKilled   Int      @default(0) @map("monsters_killed")
  bossKilled       Boolean  @default(false) @map("boss_killed")
  maxLevel         Int      @default(1) @map("max_level")
  metaGoldEarned   Int      @default(0) @map("meta_gold_earned")
  skillsAcquired   String[] @default([]) @map("skills_acquired")
  equipmentDropped String[] @default([]) @map("equipment_dropped")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sb_game_runs")
}

model DailyProgress {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  date            DateTime @default(now()) @db.Date
  challenges      Json     @default("[]")
  attendanceClaimed Boolean @default(false) @map("attendance_claimed")
  consecutiveDays Int      @default(0) @map("consecutive_days")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("sb_daily_progress")
}

model RpgSave {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  saveData  Json     @default("{}") @map("save_data")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("sb_rpg_saves")
}
