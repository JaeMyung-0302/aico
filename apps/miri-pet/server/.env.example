# Database (docker-compose.yml: miri-pet-db, 5439)
DATABASE_URL="postgresql://miripet:miripet@localhost:5439/miripet_dev?schema=public"
DATABASE_URL_TEST="postgresql://miripet:miripet@localhost:5439/miripet_test?schema=public"

# Server
PORT=4008
NODE_ENV=development
# Express trust proxy 홉 수(rate limit 클라이언트 IP 식별). 로컬 0, 운영(Cloudflare → Lightsail → Docker) 2
# 0이면 cf-connecting-ip·X-Forwarded-For를 무시한다(위조 방지)
TRUST_PROXY_HOPS=0

# JWT (Access 15분 / Refresh 30일 — refresh는 DB에 SHA-256 해시만 저장)
# HS256, 32바이트 이상 필수(미만이면 부팅 실패). 생성: openssl rand -base64 48
JWT_SECRET=
# 개발/E2E 전용 POST /auth/dev — production에서는 무시된다
ENABLE_DEV_LOGIN=false

# 동반 장소: 앱의 "내 위치" 버튼(GET /config isGpsEnabled). 위치기반서비스 신고 확인 전까지 false
ENABLE_GPS_LOCATION=false

# Social login (ID 토큰 aud 검증용). v1: 카카오 + Google (Apple 제외)
KAKAO_NATIVE_APP_KEY=
# 탈퇴 시 카카오 unlink 호출용 (서버 전용, 앱에 넣지 말 것)
KAKAO_ADMIN_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=miripet-public
R2_PRIVATE_BUCKET=miripet-private
R2_PUBLIC_BASE_URL=https://img.aico-app.com

# Expo Push
EXPO_ACCESS_TOKEN=
# 접종 리마인더(매일 10:00 KST): 10시 이후 부팅이면 당일분을 1회 실행한다. false면 끈다(통합 테스트 setup이 false로 둔다)
REMINDER_BOOT_CATCHUP=true

# Observability
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
# 비우면 NODE_ENV. 배포 워크플로가 SENTRY_RELEASE=<git sha>를 넣는다. 트레이싱 샘플링은 0~1 (기본 0 = 끔)
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
