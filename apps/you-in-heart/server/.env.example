# Database (docker-compose.yml: you-in-heart-db, 5440)
DATABASE_URL="postgresql://youinheart:youinheart@localhost:5440/youinheart_dev?schema=public"
DATABASE_URL_TEST="postgresql://youinheart:youinheart@localhost:5440/youinheart_test?schema=public"

# Server
PORT=4009
NODE_ENV=development
# Express trust proxy 홉 수(rate limit 클라이언트 IP 식별). 로컬 0, 운영(Cloudflare → Lightsail → Docker) 2
TRUST_PROXY_HOPS=0

# JWT (Access 15분 / Refresh 30일 — refresh는 DB에 SHA-256 해시만 저장)
# HS256, 32바이트 이상 필수. 생성: openssl rand -base64 48
JWT_SECRET=
# 개발/E2E 전용 POST /auth/dev-login — NODE_ENV=production이면 true여도 꺼진다(404)
ENABLE_DEV_LOGIN=true

# 카카오 로그인 (v1은 카카오만. 공개 전 Apple 로그인 추가 필요)
# 네이티브 앱 키: ID 토큰 aud 검증용
KAKAO_NATIVE_APP_KEY=
# 카카오 로컬 API(장소 검색·좌표→주소) 서버 프록시용
KAKAO_REST_API_KEY=
# 탈퇴 시 카카오 unlink 호출용 (서버 전용, 앱에 넣지 말 것)
KAKAO_ADMIN_KEY=

# Cloudflare R2 (private 버킷 하나, 접두사 c/ · incoming/ · exports/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=youinheart
R2_SECRET_ACCESS_KEY=youinheart-dev-storage
R2_PRIVATE_BUCKET=youinheart-private
# 로컬 개발 전용: S3 호환 저장소 주소(SeaweedFS 9440). 비우면 Cloudflare R2 계정 엔드포인트를 쓴다
R2_ENDPOINT=http://localhost:9440

# 연결 해제 30일 뒤 삭제(purge) 실행 여부. 운영에서 검증 전까지 false
PURGE_ENABLED=false

# Expo Push
EXPO_ACCESS_TOKEN=

# Observability — SENTRY_DSN이 비면 Sentry를 켜지 않는다. SENTRY_ENVIRONMENT가 비면 NODE_ENV, 트레이싱 샘플링은 0~1(기본 0 = 끔)
# beforeSend가 lat·lng·uri·url·body·text 키와 요청 본문·query string을 지운다
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
