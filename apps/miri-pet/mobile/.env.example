# 공개 값만 (EXPO_PUBLIC_* 는 앱 번들에 포함된다 — 비밀값 금지)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4008/api/v1
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
# 관측(D11): 비어 있으면 둘 다 no-op. PostHog distinctId는 userId만
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
# development / preview / production (비우면 production)
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# 개발 빌드에서만 로그인 화면에 '개발용 로그인'(POST /auth/dev)을 보인다. 서버 ENABLE_DEV_LOGIN=true도 필요
EXPO_PUBLIC_ENABLE_DEV_LOGIN=false
