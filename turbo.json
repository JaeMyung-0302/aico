{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**"],
      "env": ["ANTHROPIC_API_KEY"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "PORT",
        "DATABASE_URL",
        "GEMINI_API_KEY",
        "KAMIS_API_KEY",
        "KAMIS_API_ID",
        "COUPANG_ACCESS_KEY",
        "COUPANG_SECRET_KEY",
        "JWT_SECRET",
        "KAKAO_CLIENT_ID",
        "KAKAO_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "CLIENT_ORIGIN",
        "PORTONE_STORE_ID",
        "PORTONE_API_SECRET",
        "PORTONE_CHANNEL_KEY",
        "PORTONE_WEBHOOK_SECRET",
        "BILLING_ENCRYPT_KEY",
        "ADMIN_EMAILS",
        "NOTION_API_KEY",
        "GITHUB_APP_ID",
        "GITHUB_WEBHOOK_SECRET",
        "REDIS_HOST",
        "REDIS_PORT",
        "YAHOO_FINANCE_TIMEOUT",
        "PERPLEXITY_API_KEY"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
