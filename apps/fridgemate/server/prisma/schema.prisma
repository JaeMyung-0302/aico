generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FridgeType {
  ONE_DOOR
  TWO_DOOR
  SIDE_BY_SIDE
  FOUR_DOOR
  MINI
}

enum CompartmentType {
  FRIDGE_UPPER
  FRIDGE_LOWER
  FREEZER
  DOOR
  DRAWER
  VEGGIE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FoodCategory {
  MEAT
  SEAFOOD
  DAIRY
  VEGETABLE
  SEASONING
  BEVERAGE
  SNACK
  SIDE_DISH
  OTHER
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  name              String
  groupId           String?
  group             Group?             @relation(fields: [groupId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdGroups     Group[]            @relation("GroupCreator")
  joinRequests      JoinRequest[]
  pushSubscriptions PushSubscription[]
  payments          Payment[]
}

model Group {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  creatorId         String
  creator           User               @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  isPremium         Boolean            @default(false)
  premiumExpiresAt  DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now())
  users             User[]
  fridges           Fridge[]
  pushSubscriptions PushSubscription[]
  recipeHistories   RecipeHistory[]
  joinRequests      JoinRequest[]
  subscriptions     Subscription[]
  payments          Payment[]
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model JoinRequest {
  id        String             @id @default(uuid())
  userId    String
  groupId   String
  status    JoinRequestStatus  @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model PushSubscription {
  id        String   @id @default(uuid())
  groupId   String
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
}

model Fridge {
  id           String        @id @default(uuid())
  groupId      String
  type         FridgeType
  name         String
  createdAt    DateTime      @default(now())
  group           Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  compartments    Compartment[]
  recipeHistories RecipeHistory[]
}

model Compartment {
  id        String          @id @default(uuid())
  fridgeId  String
  type      CompartmentType
  label     String
  position  Int
  fridge    Fridge          @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  foodItems FoodItem[]
}

model FoodItem {
  id            String       @id @default(uuid())
  compartmentId String
  name          String
  category      FoodCategory @default(OTHER)
  quantity      Float?
  unit          String?
  expiryDate    DateTime?    @db.Date
  memo          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  compartment   Compartment  @relation(fields: [compartmentId], references: [id], onDelete: Cascade)
}

model RecipeHistory {
  id             String   @id @default(uuid())
  groupId        String
  fridgeId       String
  ingredientHash String
  ingredients    Json
  response       Json
  createdAt      DateTime @default(now())
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fridge         Fridge   @relation(fields: [fridgeId], references: [id], onDelete: Cascade)

  @@index([fridgeId, ingredientHash, createdAt])
  @@index([groupId, createdAt])
}

model Subscription {
  id               String             @id @default(uuid())
  groupId          String
  billingKey       String
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime           @db.Timestamptz(3)
  cancelledAt      DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  group            Group              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payments         Payment[]

  @@index([groupId, status])
}

model Payment {
  id               String        @id @default(uuid())
  groupId          String
  payerId          String
  subscriptionId   String?
  amount           Int
  status           PaymentStatus @default(PENDING)
  portonePaymentId String?       @unique
  failReason       String?
  paidAt           DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now())
  group            Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payer            User          @relation(fields: [payerId], references: [id], onDelete: Restrict)
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([payerId])
}

model DailyUsage {
  id      String   @id @default(uuid())
  groupId String
  date    DateTime @db.Date
  count   Int      @default(0)

  @@unique([groupId, date])
}
