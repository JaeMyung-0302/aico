generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(uuid())
  supabaseId        String          @unique
  nickname          String?
  gold              Int             @default(500)
  summonStones      Int             @default(0)
  maxMonsters       Int             @default(20)
  pityCounter       Int             @default(0)
  tutorialCompleted Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  monsters          Monster[]
  equipment         Equipment[]
  energyLogs        EnergyLog[]
  dungeonResults    DungeonResult[]
  codex             Codex[]
  party             Party?
  stageResults      StageResult[]
  summonHistory     SummonHistory[]
}

model Monster {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  speciesId   String?
  species     MonsterSpecies? @relation(fields: [speciesId], references: [id])
  name        String?
  element     String
  personality String
  atk         Float           @default(5)
  def         Float           @default(5)
  hp          Float           @default(5)
  agi         Float           @default(5)
  intStat     Float           @default(5)
  rec         Float           @default(5)
  growthStage String          @default("Egg")
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  equipment   Equipment[]
  partySlot1  Party?          @relation("PartySlot1")
  partySlot2  Party?          @relation("PartySlot2")
  partySlot3  Party?          @relation("PartySlot3")
}

model MonsterSpecies {
  id            String          @id @default(uuid())
  name          String          @unique
  element       String
  personality   String
  rarity        String          @default("Common")
  baseAtk       Float           @default(5)
  baseDef       Float           @default(5)
  baseHp        Float           @default(5)
  baseAgi       Float           @default(5)
  baseInt       Float           @default(5)
  baseRec       Float           @default(5)
  description   String?
  monsters        Monster[]
  codexEntries    Codex[]
  summonHistory   SummonHistory[]
  speciesImages   SpeciesImage[]
  evolutionsFrom  EvolutionPath[] @relation("EvolutionFrom")
  evolutionsTo    EvolutionPath[] @relation("EvolutionTo")
  fusionAsParent1 FusionRecipe[]  @relation("FusionParent1")
  fusionAsParent2 FusionRecipe[]  @relation("FusionParent2")
  fusionAsResult  FusionRecipe[]  @relation("FusionResult")

  speciesSkills   SpeciesSkill[]

  @@unique([element, personality])
}

model Skill {
  id          String         @id @default(uuid())
  name        String         @unique
  element     String
  category    String         // "physical" | "magical"
  power       Float          @default(1.0)
  accuracy    Float          @default(1.0)
  cooldown    Int            @default(0)
  description String?
  speciesSkills SpeciesSkill[]
}

model SpeciesSkill {
  id         String         @id @default(uuid())
  speciesId  String
  species    MonsterSpecies @relation(fields: [speciesId], references: [id])
  skillId    String
  skill      Skill          @relation(fields: [skillId], references: [id])
  learnStage String         @default("Egg")

  @@unique([speciesId, skillId])
}

model SpeciesImage {
  id          String         @id @default(uuid())
  speciesId   String
  species     MonsterSpecies @relation(fields: [speciesId], references: [id])
  growthStage String
  imageData   String
  createdAt   DateTime       @default(now())

  @@unique([speciesId, growthStage])
}

model Codex {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  speciesId    String
  species      MonsterSpecies @relation(fields: [speciesId], references: [id])
  discoveredAt DateTime       @default(now())

  @@unique([userId, speciesId])
}

model Party {
  id      String   @id @default(uuid())
  userId  String   @unique
  user    User     @relation(fields: [userId], references: [id])
  slot1Id String?  @unique
  slot1   Monster? @relation("PartySlot1", fields: [slot1Id], references: [id])
  slot2Id String?  @unique
  slot2   Monster? @relation("PartySlot2", fields: [slot2Id], references: [id])
  slot3Id String?  @unique
  slot3   Monster? @relation("PartySlot3", fields: [slot3Id], references: [id])
}

model Chapter {
  id          String  @id @default(uuid())
  number      Int     @unique
  name        String
  description String?
  stages      Stage[]
}

model Stage {
  id           String        @id @default(uuid())
  chapterId    String
  chapter      Chapter       @relation(fields: [chapterId], references: [id])
  stageNumber  Int
  isBoss       Boolean       @default(false)
  energyCost   Int           @default(2)
  enemies      Json
  rewards      Json
  stageResults StageResult[]

  @@unique([chapterId, stageNumber])
}

model StageResult {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  stageId   String
  stage     Stage    @relation(fields: [stageId], references: [id])
  stars     Int
  clearedAt DateTime @default(now())

  @@unique([userId, stageId])
}

model SummonHistory {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  speciesId  String
  species    MonsterSpecies @relation(fields: [speciesId], references: [id])
  summonType String
  createdAt  DateTime       @default(now())
}

model EvolutionPath {
  id             String         @id @default(uuid())
  fromSpeciesId  String
  fromSpecies    MonsterSpecies @relation("EvolutionFrom", fields: [fromSpeciesId], references: [id])
  toSpeciesId    String
  toSpecies      MonsterSpecies @relation("EvolutionTo", fields: [toSpeciesId], references: [id])
  goldCost       Int            @default(1000)
  minGrowthStage String         @default("Adult")

  @@unique([fromSpeciesId, toSpeciesId])
}

model FusionRecipe {
  id               String         @id @default(uuid())
  parent1SpeciesId String
  parent1Species   MonsterSpecies @relation("FusionParent1", fields: [parent1SpeciesId], references: [id])
  parent2SpeciesId String
  parent2Species   MonsterSpecies @relation("FusionParent2", fields: [parent2SpeciesId], references: [id])
  resultSpeciesId  String
  resultSpecies    MonsterSpecies @relation("FusionResult", fields: [resultSpeciesId], references: [id])
  goldCost         Int            @default(500)

  @@unique([parent1SpeciesId, parent2SpeciesId])
}

model Equipment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  monsterId String?
  monster   Monster? @relation(fields: [monsterId], references: [id])
  name      String
  slot      String
  grade     String
  statType  String
  statValue Float
  createdAt DateTime @default(now())
}

model EnergyLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  activity String
  usedAt   DateTime @default(now())
}

model DungeonResult {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  floor      Int
  difficulty String
  result     String
  goldReward Int
  createdAt  DateTime @default(now())
}
